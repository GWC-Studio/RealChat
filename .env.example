# RealChat 环境变量配置
# 复制此文件为 .env 并填入真实值

# API 配置 (兼容 OpenAI 格式)
REALCHAT_API_BASE=https://api.deepseek.com/v1
REALCHAT_API_KEY=your-api-key-here
REALCHAT_MODEL=deepseek-chat

# 用户消息缓冲等待时间（秒）
REALCHAT_BUFFER_TIMEOUT=2.0

# 深度思考等级: off / minimal / low / medium / high / extra_high / maximum
REALCHAT_THINKING_LEVEL=off

# 网关令牌鉴权（留空 = 不启用）
REALCHAT_AUTH_TOKEN=

# 服务器监听
REALCHAT_HOST=0.0.0.0
REALCHAT_PORT=5000
